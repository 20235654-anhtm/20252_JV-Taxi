# Backend Environment Variables
PORT=5000

# JWT Secret for authentication token signing
# IMPORTANT: Change this to a strong, unique secret in production!
JWT_SECRET="your_strong_jwt_secret_here"

# Supabase Configurations
SUPABASE_URL="https://YOUR_SUPABASE_PROJECT.supabase.co"
SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY_HERE"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY_HERE"

# Database Connection
# Replace [YOUR-PASSWORD] with your actual Supabase database password
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.YOUR_SUPABASE_PROJECT.supabase.co:5432/postgres"

# Stripe Configurations
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
