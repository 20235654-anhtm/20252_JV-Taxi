# ==============================================================================
# JV-Taxi Backend - Environment Variables Configuration Template
# Copy this file as '.env' and fill in your actual credentials.
# ==============================================================================

# --- Server Settings ---
PORT=5000
NODE_ENV=development

# --- Database Integration (PostgreSQL / Supabase) ---
# Format: postgresql://[user]:[password]@[host]:[port]/[database_name]
DATABASE_URL="postgresql://postgres:password@localhost:5432/jv_taxi_db"

# --- Authentication Settings ---
# A strong random secret key to sign and verify JSON Web Tokens (JWT)
JWT_SECRET="your_jwt_signing_secret_key_here"
JWT_EXPIRES_IN="7d"

# --- Stripe Payment Gateway ---
# Obtain these API keys from your Stripe Dashboard (https://dashboard.stripe.com/)
STRIPE_SECRET_KEY="sk_test_your_secret_key"
STRIPE_PUBLISHABLE_KEY="pk_test_your_publishable_key"

# --- Daily.co WebRTC Video Calling ---
# Obtain your API key from the Daily.co Dashboard (https://dashboard.daily.co/)
DAILY_API_KEY="your_daily_co_api_key_here"
